.DS_Store
.build/
.swiftpm/
Packages/
*.xcodeproj
xcuserdata/
build/
DerivedData/
dist/
.claude/

# Local Apple signing material. Never commit certificates, requests, private
# keys, provisioning profiles, notarization keys, or signing environment files.
.signing-private/
*.certSigningRequest
*.p12
*.p8
*.cer
*.provisionprofile
*.mobileprovision
.env
.env.signing

# Local AI-agent instructions and recipes are workstation-specific and must
# not be published with the open-source project.
AGENTS.md
CLAUDE.md
SKILL.md
.codex/
.agents/

# The bundled shared Claude setup is shipped product content, not local
# instructions.
!SharedConfig/claude-shared/CLAUDE.md
!SharedConfig/claude-shared/skills/*/SKILL.md
